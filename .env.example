# --- APIX connection (required) ---
# Your APIX instance origin (no trailing slash). For local dev pointing at a host APIX:
APIX_BASE_URL=http://host.docker.internal:3000
# Account-scoped API Key V2 (AutoFin-Api-Key header). Used for the provisioning channel.
AUTOFIN_API_KEY=af_live_replace_me

# --- Custody backend: AWS Secrets Manager (default adapter) ---
AWS_REGION=us-east-1
# Secret name prefix; full name = "{prefix}{key_id}", e.g. apix/signers/del_ab12...
SECRET_PREFIX=apix/signers/

# Dev only — point the SDK at Localstack. LEAVE EMPTY for real AWS.
AWS_ENDPOINT_URL=http://localstack:4566

# --- Poll cadence ---
# Plain seconds (5) or a Go duration ("2s", "200ms"). Provisioning runs less often than signing.
PROVISION_INTERVAL=5
SIGN_INTERVAL=2
HTTP_TIMEOUT=15

# --- Pre-existing signers to back ---
# Comma-separated key_ids to sign for, in addition to any this instance provisions itself.
# Leave empty if this instance only provisions new signers.
WATCHED_KEY_IDS=
